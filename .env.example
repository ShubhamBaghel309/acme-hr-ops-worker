# Copy to .env and fill in the two API keys. Never commit .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol

LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=acme-hr-ops-worker
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com   # only for non-US regions

# Local sandbox company "Acme". These are fake test credentials for the local
# portal only; the agent's login code reads them, the LLM never sees them.
SANDBOX_URL=http://127.0.0.1:8001
SANDBOX_USER=ops.bot@acme.example
SANDBOX_PASSWORD=acme-sandbox-pass
SANDBOX_ADMIN_TOKEN=local-admin-token
